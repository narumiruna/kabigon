flowchart TD
    Input["URL or local PDF"] --> Entry{"Entry point"}
    Entry --> OneShot["load_url / load_url_sync / load_url_detailed"]
    Entry --> Reusable["async with KabigonClient"]
    Entry --> Explicit["CLI --loader debugging override"]

    OneShot --> ShortClient["Short-lived KabigonClient"]
    ShortClient --> Plan
    Reusable --> Plan["Pipeline catalog: parse source and select content contract"]
    Explicit --> ExplicitPlan["Preserve explicit loader order; no source verification"]

    Plan --> Source{"Source target?"}
    Source -->|Strict| Strict["Applicable source strategies only"]
    Source -->|News| News["BBC/CNN/LTN extractor with HTTPX → curl_cffi → browser transport"]
    Source -->|Generic page| Generic["curl_cffi → browser variants → HTTPX"]
    ExplicitPlan --> Chain
    Strict --> Chain["Single LoadChain runtime"]
    News --> Chain
    Generic --> Chain

    Chain --> Eligible{"Any alternative has its environment requirements?"}
    Eligible -->|No| Missing["MissingRequirementError before factory or network"]
    Eligible -->|Yes| Next{"Next attempt within shared deadline?"}
    Next -->|Missing requirement| Skip["Record skipped attempt"]
    Skip --> Next
    Next -->|Available| Lazy["Lazy implementation import and factory"]
    Lazy --> Admit["Bounded request/browser/worker admission; queue time is budgeted"]
    Admit --> Load["await Loader.load(url)"]
    Load --> Accept{"Non-whitespace and accepted content category?"}
    Accept -->|No| Failure["Record stable loader ID, elapsed time, and error type"]
    Failure --> Next
    Accept -->|Yes| Detailed["LoadResult: content, actual loader/category, downgrade, attempts"]
    Next -->|Expired or exhausted| Error["LoaderError.details plus structured attempts"]

    Detailed --> Text["Existing text APIs project result.content"]
    Detailed --> Structured["load_url_detailed returns LoadResult"]
    Text --> Cleanup
    Structured --> Cleanup["Close one-shot resources or retain client-owned sessions/browser"]
    Error --> Cleanup

    classDef plan fill:#ecfdf5,stroke:#047857,color:#064e3b
    classDef exec fill:#fef3c7,stroke:#b45309,color:#78350f
    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    class Plan,Source,Strict,News,Generic,ExplicitPlan,Eligible plan
    class Chain,Next,Lazy,Admit,Load,Accept,Skip,Failure exec
    class Detailed,Text,Structured,Cleanup success
    class Missing,Error error
